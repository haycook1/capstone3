# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: orchestrator.py
from typing import Optional, TypedDict

from langgraph.graph import END, StateGraph

from agents.retrieval_agent import run_retrieval_agent
from agents.sql_agent import run_sql_agent
from bedrock_client import invoke_claude
from tokenomics_logger import calculate_full_query_cost, log_decision


from langchain_core.tools import tool


@tool
def sql_tool(question: str) -> dict:
    """Use only for structured business data in RDS.

    Use this tool for counts, rankings, filters, budgets, invoices,
    clients, projects, consultants, and other database questions.
    Do not use it for policies, procedures, reports, or unstructured
    document content.
    """
    return run_sql_agent(question)


@tool
def retrieval_tool(question: str) -> dict:
    """Use only for unstructured content indexed in OpenSearch.

    Use this tool for policies, procedures, reports, playbooks,
    case studies, contracts, scopes, and document-based explanations.
    Do not use it for live database counts, rankings, invoices,
    or other structured RDS data.
    """
    return run_retrieval_agent(question)


TOOL_REGISTRY = [sql_tool, retrieval_tool]


class OrchestratorState(TypedDict, total=False):
    question: str
    route: Optional[str]
    sql_result: Optional[dict]
    retrieval_result: Optional[dict]
    final_answer: Optional[str]
    token_usage: Optional[dict]
    token_breakdown: Optional[dict]
    cost_breakdown: Optional[dict]


SQL_KEYWORDS = (
    "how many", "count", "total", "average", "sum", "revenue",
    "how much", "list all", "which clients", "projects", "invoices",
    "consultants", "compare", "trend", "budget",
)

DOC_KEYWORDS = (
    "policy", "process", "procedure", "methodology", "what is",
    "explain", "describe", "guidelines", "approach", "onboarding",
)


def route_question(state: OrchestratorState) -> OrchestratorState:
    question = state["question"].lower()
    is_sql = any(keyword in question for keyword in SQL_KEYWORDS)
    is_doc = any(keyword in question for keyword in DOC_KEYWORDS)

    route = "both" if is_sql and is_doc else "sql" if is_sql else "retrieval"
    log_decision("routing", state["question"], {"route": route})
    return {**state, "route": route}


def _failed_result(message: str) -> dict:
    return {
        "success": False,
        "answer": message,
        "sources": [],
        "metadata": {
            "token_usage": {"input": 0, "output": 0},
        },
    }


def call_sql_agent(state: OrchestratorState) -> OrchestratorState:
    if state.get("route") not in ("sql", "both"):
        return state

    try:
        result = run_sql_agent(state["question"])
    except Exception as exc:
        result = _failed_result(f"SQL agent exception: {exc}")
    return {**state, "sql_result": result}


def call_retrieval_agent(state: OrchestratorState) -> OrchestratorState:
    if state.get("route") not in ("retrieval", "both"):
        return state

    try:
        result = run_retrieval_agent(state["question"])
    except Exception as exc:
        result = _failed_result(f"Retrieval agent exception: {exc}")
    return {**state, "retrieval_result": result}


def _usage(result: Optional[dict]) -> dict:
    return (result or {}).get("metadata", {}).get(
        "token_usage", {"input": 0, "output": 0}
    )


def synthesise(state: OrchestratorState) -> OrchestratorState:
    sql_result = state.get("sql_result")
    retrieval_result = state.get("retrieval_result")
    sql_tokens = _usage(sql_result)
    retrieval_tokens = _usage(retrieval_result)

    context_parts = []
    failure_parts = []

    for label, result in (
        ("SQL Agent", sql_result),
        ("Retrieval Agent", retrieval_result),
    ):
        if not result:
            continue
        if result.get("success"):
            context_parts.append(
                f"{label}:\n{result['answer']}\nSources: {result.get('sources', [])}"
            )
        else:
            failure_parts.append(f"{label} unavailable: {result.get('answer')}")

    if not context_parts:
        return {
            **state,
            "final_answer": (
                "I could not produce a reliable answer. "
                + " ".join(failure_parts)
            ),
            "token_usage": {"input": 0, "output": 0},
            "token_breakdown": {
                "sql_agent": sql_tokens,
                "retrieval_agent": retrieval_tokens,
                "synthesis": {"input": 0, "output": 0},
            },
            "cost_breakdown": calculate_full_query_cost(
                sql_tokens, retrieval_tokens, {"input": 0, "output": 0}
            ),
        }

    prompt = (
        "Answer the question only from successful agent results below. "
        "Do not invent facts from unavailable agents. "
        "Clearly distinguish database evidence from document evidence. "
        "Cite the agent and its listed sources.\n\n"
        f"Question: {state['question']}\n\n"
        f"Successful results:\n{'\\n\\n'.join(context_parts)}\n\n"
        f"Unavailable results:\n{'\\n'.join(failure_parts) or 'None'}"
    )

    synthesis = invoke_claude(prompt, max_tokens=800)
    synthesis_tokens = {
        "input": synthesis["input_tokens"],
        "output": synthesis["output_tokens"],
    }

    return {
        **state,
        "final_answer": synthesis["text"],
        "token_usage": synthesis_tokens,
        "token_breakdown": {
            "sql_agent": sql_tokens,
            "retrieval_agent": retrieval_tokens,
            "synthesis": synthesis_tokens,
        },
        "cost_breakdown": calculate_full_query_cost(
            sql_tokens, retrieval_tokens, synthesis_tokens
        ),
    }


def build_orchestrator():
    graph = StateGraph(OrchestratorState)
    graph.add_node("router", route_question)
    graph.add_node("sql_agent", call_sql_agent)
    graph.add_node("retrieval_agent", call_retrieval_agent)
    graph.add_node("synthesiser", synthesise)

    graph.set_entry_point("router")
    graph.add_edge("router", "sql_agent")
    graph.add_edge("sql_agent", "retrieval_agent")
    graph.add_edge("retrieval_agent", "synthesiser")
    graph.add_edge("synthesiser", END)
    return graph.compile()
